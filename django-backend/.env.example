# =============================================================================
# SoroScan Django backend environment
# =============================================================================
#
# Copy this file before starting development:
#
#   cp django-backend/.env.example django-backend/.env
#
# Never commit real secrets.
#
# Required outside the dedicated test settings:
#   SECRET_KEY          — Django cryptographic signing key (required, no default in prod)
#   DATABASE_URL        — PostgreSQL connection string (required)
#   REDIS_URL           — Redis connection string used for cache, Channels & Celery (required)
#   SOROBAN_RPC_URL     — Soroban RPC endpoint for event streaming (required)
#   STELLAR_NETWORK_PASSPHRASE — Network identifier string (required, varies by network)
#   SOROSCAN_CONTRACT_ID — Stellar contract address to index (required, starts with 'C')
#
# See ../ENVIRONMENT.md for every supported variable, type, default,
# and development, testing, and production examples.

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------

# REQUIRED. Django's cryptographic signing key. Must be a long, random string.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never use the insecure development value in staging or production.
SECRET_KEY=django-insecure-development-key-change-before-production-1234567890

# Set to False in production. Exposes detailed error pages and enables debug toolbar.
DEBUG=True

# Comma-separated list of hostnames Django will serve. Must include your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base URL of the frontend app — used for CORS and redirect generation.
FRONTEND_BASE_URL=http://localhost:3000

# Custom path for Django Admin site (defaults to admin/ for dev, customize in prod for security)
ADMIN_URL_PATH=admin/

# Optional explicit application version.
# SOFTWARE_VERSION=1.0.0

# Set to True to enable Silk SQL/request profiling (development only, adds overhead).
ENABLE_SILK=False

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# REQUIRED. PostgreSQL connection string. Format: postgresql://user:pass@host:port/dbname
# Docker Compose configuration:
DATABASE_URL=postgresql://postgres:postgres@db:5432/soroscan

# Local PostgreSQL alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soroscan

# How long (seconds) Django keeps a DB connection open between requests. 0 = close each request.
DB_CONN_MAX_AGE=300

# Seconds to wait when opening a new database connection before raising an error.
DB_CONNECT_TIMEOUT=5

# application_name shown in pg_stat_activity — useful for query attribution in slow-query logs.
DB_APPLICATION_NAME=soroscan-backend

# PostgreSQL statement timeout in milliseconds (default: 5000).
# Prevents runaway queries from holding connections.
# DATABASE_STATEMENT_TIMEOUT=5000

# Number of Gunicorn/uvicorn worker processes. Rule of thumb: 2 * CPU cores + 1.
WEB_CONCURRENCY=4

# Database connections allocated per worker process.
DB_CONNECTIONS_PER_WORKER=4

# Minimum connections kept open in the connection pool.
DB_POOL_MIN_SIZE=2

# Hard cap on total connections across all workers. Should not exceed PostgreSQL max_connections.
DB_POOL_HARD_LIMIT=40

# -----------------------------------------------------------------------------
# Redis, cache, Channels, and Celery
# -----------------------------------------------------------------------------

# REQUIRED. Redis connection string. Used for Django cache, Django Channels
# (WebSocket layer), and Celery broker/result backend.
# Docker Compose configuration:
REDIS_URL=redis://redis:6379/0

# Local Redis alternative:
# REDIS_URL=redis://localhost:6379/0

# How long (seconds) query results are cached before expiring. Set to 0 to disable caching.
QUERY_CACHE_TTL_SECONDS=60

# Seconds to wait for in-flight requests to finish during a graceful shutdown.
SHUTDOWN_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Stellar and Soroban
# -----------------------------------------------------------------------------

# REQUIRED. Soroban RPC endpoint for event streaming and ledger queries.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# REQUIRED. Network passphrase that identifies the Stellar network.
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# REQUIRED. Stellar contract address (C...) to index. Replace with a deployed contract ID.
SOROSCAN_CONTRACT_ID=CCAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional Ed25519 secret key used by the indexer to sign ingested events.
INDEXER_SECRET_KEY=

# Optional Ed25519 secret key for admin-level operations.
ADMIN_SECRET_KEY=

# Per-network RPC endpoints. Override these to point to different providers.
TESTNET_RPC_URL=https://soroban-testnet.stellar.org
MAINNET_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/public
FUTURENET_RPC_URL=https://soroban-futurenet.stellar.org

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of origins allowed to make cross-origin requests.
# Must include the frontend origin in production (e.g. https://app.soroscan.io).
ALLOWED_ORIGINS=http://localhost:3000

# Logging Configuration
# Set to "json" for structured JSON log output (recommended for production/Docker).
# JSON logs include: timestamp, level, logger name, request_id, task_id,
#                    contract_id, ledger_sequence, and the log message.
# Leave empty for human-readable text format (development default).
LOG_FORMAT=

# Sentry Configuration (Optional)
# Leave SENTRY_DSN empty to disable Sentry error tracking entirely.
# No PII is sent: send_default_pii=False + a before_send scrub hook strip
# secrets/auth headers from events before transmission (Issue #763).
# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# Request rate limits per endpoint category. Format: <count>/<period>
# Periods: second, minute, hour, day.
# RATE_LIMIT_ANON    — unauthenticated requests (IP-based)
# RATE_LIMIT_USER    — authenticated API key requests
# RATE_LIMIT_INGEST  — ingest endpoint (indexer writes)
# RATE_LIMIT_GRAPHQL — GraphQL endpoint
RATE_LIMIT_ANON=60/minute
RATE_LIMIT_USER=300/minute
RATE_LIMIT_INGEST=10/minute
RATE_LIMIT_GRAPHQL=60/minute

# Per-endpoint overrides for the search and stats REST endpoints.
ENDPOINT_RATE_LIMIT_SEARCH=30/minute
ENDPOINT_RATE_LIMIT_STATS=100/minute

# -----------------------------------------------------------------------------
# Data retention and deduplication
# -----------------------------------------------------------------------------

# Days to retain EventDeduplicationLog records before the cleanup task prunes them.
DEDUP_LOG_RETENTION_DAYS=90

# Days to retain ContractEvent records before archival/pruning (per DataRetentionPolicy).
EVENT_RETENTION_DAYS=30
SOROSCAN_EVENT_RETENTION_DAYS=90
ALERT_DEDUP_WINDOW_SECONDS=300

# Window (seconds) within which identical webhook payloads are suppressed as duplicates.
WEBHOOK_DEDUP_WINDOW_SECONDS=300

# Window (seconds) for deduplicating downstream alert dispatches (Slack, email, webhook).
DOWNSTREAM_ALERT_DEDUP_SECONDS=3600

# -----------------------------------------------------------------------------
# Webhook escalation and signing
# -----------------------------------------------------------------------------

# Seconds to wait before escalating an unacknowledged webhook to the next channel.
WEBHOOK_ESCALATION_TIMEOUT_SECONDS=10

# Dedup window (seconds) for escalation events — prevents repeated escalations for the same incident.
WEBHOOK_ESCALATION_DEDUP_SECONDS=300

# Escalation target URLs/identifiers. Leave empty to disable a channel.
WEBHOOK_ESCALATION_SLACK_TARGET=
WEBHOOK_ESCALATION_SMS_TARGET=
WEBHOOK_ESCALATION_PAGERDUTY_TARGET=

# Optional 32-byte hexadecimal Ed25519 seed used to sign outgoing webhook payloads.
# Leave empty to disable payload signing.
WEBHOOK_ED25519_SIGNING_SEED=

# -----------------------------------------------------------------------------
# Cost estimates in USD
# -----------------------------------------------------------------------------

# Per-unit cost rates used to calculate estimated usage costs in OrganizationCostSnapshot.
# Adjust these to match your actual infrastructure pricing.
COST_RPC_PER_CALL_USD=0.00001
COST_STORAGE_PER_GB_USD=0.10
COST_COMPUTE_PER_UNIT_USD=0.00002

# -----------------------------------------------------------------------------
# GraphQL
# -----------------------------------------------------------------------------

# Set to False in production to prevent schema introspection by external clients.
GRAPHQL_INTROSPECTION_ENABLED=True

# Maximum allowed query complexity score. Queries exceeding this are rejected.
GRAPHQL_MAX_COMPLEXITY=1000

# Enable N+1 query detection. Logs a warning when a resolver issues too many DB queries.
GRAPHQL_N1_DETECTION_ENABLED=True
# Number of DB queries per resolver before an N+1 warning is emitted (default: 5).
GRAPHQL_N1_DETECTION_THRESHOLD=5

# Log level for GraphQL resolver performance messages. One of: DEBUG, INFO, WARNING, ERROR.
GRAPHQL_RESOLVER_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Contract snapshots
# -----------------------------------------------------------------------------

# How many ledgers between full contract state snapshots.
CONTRACT_SNAPSHOT_INTERVAL=1000

# Maximum snapshot payload size in bytes (default: 1 MiB).
CONTRACT_SNAPSHOT_MAX_BYTES=1048576

# -----------------------------------------------------------------------------
# Logging and performance
# -----------------------------------------------------------------------------

# Set to json for structured logs.
LOG_FORMAT=

# Threshold in milliseconds for logging slow REST API queries.
SLOW_QUERY_THRESHOLD_MS=100

# Threshold in seconds for logging slow raw database queries.
DATABASE_SLOW_QUERY_THRESHOLD=1.0

# Requests slower than this (milliseconds) log a JSON breakdown of
# db_time_ms and cpu_time_ms.
REQUEST_LATENCY_LOG_THRESHOLD_MS=100

# SILK_PROFILER_LOG_DIR=/app/logs/profiler

# -----------------------------------------------------------------------------
# Email and alerts
# -----------------------------------------------------------------------------

# Django email backend. Use django.core.mail.backends.console.EmailBackend in development.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@soroscan.io

# Timeout (seconds) for outgoing Slack alert HTTP requests.
SLACK_ALERT_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# External event streaming
# -----------------------------------------------------------------------------

# Set to True to forward ingested events to an external streaming backend.
EVENT_STREAMING_ENABLED=False

# Supported values: kafka, pubsub, sqs
EVENT_STREAMING_BACKEND=kafka

# Kafka settings (used when EVENT_STREAMING_BACKEND=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=soroscan.events
KAFKA_SCHEMA_REGISTRY_URL=

# Google Cloud Pub/Sub settings (used when EVENT_STREAMING_BACKEND=pubsub)
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC=soroscan.events

# AWS SQS settings (used when EVENT_STREAMING_BACKEND=sqs)
SQS_QUEUE_URL=

# -----------------------------------------------------------------------------
# S3-compatible archive storage
# -----------------------------------------------------------------------------

# AWS credentials for archiving events to S3. Leave empty if archival is disabled.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# Override for S3-compatible stores (MinIO, Localstack, etc.). Leave empty for AWS.
AWS_S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------

# Leave empty to disable Sentry error tracking entirely.
# Set to your project DSN from https://sentry.io to enable.
SENTRY_DSN=

# Fraction of transactions to send to Sentry for performance monitoring (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1

# Environment tag shown in Sentry. Use 'production', 'staging', or 'development'.
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Request limits
# -----------------------------------------------------------------------------

# Maximum allowed request body size in bytes. Default: 10 MiB.
# Increase for endpoints that accept large uploads (e.g. contract source uploads).
MAX_REQUEST_BODY_SIZE=10485760

# -----------------------------------------------------------------------------
# Optional Docker Compose host-port overrides
# -----------------------------------------------------------------------------

# Webhook Delivery Retention (Issue #765)
# Number of days to retain WebhookDeliveryLog entries before automatic pruning.
# Minimum recommended value is 7; default is 30.
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# Docker Compose Port Overrides (Optional)
# Uncomment to override default ports if you have conflicts on your local machine.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# WEB_PORT=8000

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------

# Dedicated tests use in-memory services:
#
# DJANGO_SETTINGS_MODULE=soroscan.settings_test
